{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "feedbai-hub",
  // internet4000's Cloudflare account (not a secret): deploys and `wrangler secret put` go here,
  // even when you are logged in to several accounts. Remove or change it for your own hub.
  "account_id": "46bcc6e9a78b2e839068c0685143e1a2",
  "main": "hub/worker.js",
  "compatibility_date": "2026-10-01",
  // process.env is populated from vars and secrets: src/config.js reads accounts from it
  "compatibility_flags": ["nodejs_compat"],
  // The website (site/: Astro + Starlight, docs synced from docs/), built before every deploy and `wrangler dev`.
  // Its files are served first; the Worker gets the rest (/v1/…, /.well-known/atproto-did, 404s).
  "build": { "command": "npm ci --prefix site && npm run build --prefix site" },
  // The Worker runs first: it keeps the sign-in page alone on FEEDBAI_AUTH_HOST (hub/worker.js)
  "assets": { "directory": "./site/dist", "binding": "ASSETS", "run_worker_first": true },
  // The read API, per client IP: 30 requests a minute (hub/worker.js)
  "ratelimits": [{ "name": "READ_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  // The deployed version's id, shown by /v1/status
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": { "crons": ["*/10 * * * *"] },
  "routes": [
    { "pattern": "feedbai.internet4000.com", "custom_domain": true },
    // "Save to my Bluesky account" signs in here, on its own origin
    { "pattern": "auth.feedbai.internet4000.com", "custom_domain": true }
  ],
  "vars": {
    "FEEDBAI_MATRIX_USER": "@feedbai:matrix.org",
    "FEEDBAI_BLUESKY_IDENTIFIER": "feedbai.internet4000.com",
    // served at /.well-known/atproto-did: makes the hub's domain the bot's Bluesky handle
    "FEEDBAI_BLUESKY_DID": "did:plc:kwx5rsbzzksolfdxfjnu3lx4",
    "FEEDBAI_APP_URL": "https://github.com/apps/feedbai",
    "FEEDBAI_AUTH_HOST": "auth.feedbai.internet4000.com",
    // Invite-only for now: the projects that may use this hub's bots and accounts, comma-separated
    // (hub/allow.js). Adding one is a reviewed change to this line. Remove it to open the hub to all.
    "FEEDBAI_PROJECTS": "internet4000/feedbai"
  },
  // Preview builds (wrangler preview, per branch): no cron, no secrets, so the page
  // renders and the API answers with a clear error. Public values only.
  "previews": {
    "vars": {
      "FEEDBAI_MATRIX_USER": "@feedbai:matrix.org",
      "FEEDBAI_BLUESKY_IDENTIFIER": "feedbai.internet4000.com",
    // served at /.well-known/atproto-did: makes the hub's domain the bot's Bluesky handle
    "FEEDBAI_BLUESKY_DID": "did:plc:kwx5rsbzzksolfdxfjnu3lx4",
      "FEEDBAI_APP_URL": "https://github.com/apps/feedbai",
      "FEEDBAI_PROJECTS": "internet4000/feedbai"
    }
  },
  "observability": { "enabled": true }
}

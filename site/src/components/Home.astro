---
/**
 * The home page: one card that says what feedbai does for everyone, the projects listening (live), three
 * steps to set one up. Plain and quiet on purpose (like 4000.radio, joblist.today); the docs stay in Starlight.
 */
const REPO = 'https://github.com/internet4000/feedbai'
const BOT = '@feedbai:matrix.org'
const INSTALL = 'npm i -g @internet4000/feedbai && feedbai'
const SNIPPET = '<script type="module" src="https://feedbai.internet4000.com/embed.js" data-project="https://github.com/you/repo"></script>'
const title = 'feedbai: hear your community, act on it'
const description = 'feedbai gathers what people say about your project, in your chat, on Bluesky and on your site, into your issues, so you can act on it, and answers them back. Free, open source, nothing stored.'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://feedbai.internet4000.com/" />
    <script type="module" src="/embed.js" data-project={REPO} data-matrix="#feedbai:matrix.org" data-bluesky="#feedbai"></script>
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="/">feedbai</a>
      <nav>
        <a href="/docs/">Docs</a>
        <a href={REPO}>Source</a>
      </nav>
    </header>

    <main>
      <section class="card intro">
        <h1>Hear your community. Act on it.</h1>
        <ul>
          <li>People say what they think where they already are: your chat, Bluesky, a button on your site.</li>
          <li>feedbai gathers it into your issues, so you (and your agents, if you use them) fix what matters.</li>
          <li>Everyone hears back where they spoke, when it's fixed.</li>
        </ul>
        <p class="small">Free and open source. No account with us; we keep nothing.</p>
        <p class="actions"><a href="#start"><b>Set up your project</b></a> <a href="/feedback/">Give feedback to a project</a></p>
      </section>

      <section aria-labelledby="live-title">
        <div class="head">
          <h2 id="live-title">Listening now <small>last 30 days</small></h2>
          <a class="hub" href="/v1/status" data-hub><span class="dot" aria-hidden="true"></span><span data-hub-text>Hub</span></a>
        </div>
        <ul class="rows" data-projects aria-live="polite">
          <li class="row muted">Loading…</li>
        </ul>
        <p class="small">Numbers and links only: what people wrote stays where they wrote it. Your project here? Add <code>"listed": true</code> to its <code>feedbai.config.json</code>.</p>
      </section>

      <section aria-labelledby="start">
        <div class="head"><h2 id="start">Set up your project</h2><a href="/docs/getting-started/">Guide</a></div>
        <ol class="rows steps">
          <li class="row">
            <span class="n">1</span>
            <div><b>Find where your community talks.</b> In your project's folder: <span class="copy"><code>{INSTALL}</code><button type="button" data-copy={INSTALL}>Copy</button></span></div>
          </li>
          <li class="row">
            <span class="n">2</span>
            <div><b>Let it listen.</b> Invite the bot to your chat room, and <a href="https://github.com/apps/feedbai">install the GitHub App</a>. <span class="copy"><code>{BOT}</code><button type="button" data-copy={BOT}>Copy</button></span></div>
          </li>
          <li class="row">
            <span class="n">3</span>
            <div><b>Add a Feedback button</b> to your site, like the one at the bottom right. <a href="/docs/button/">Options</a> <span class="copy"><code>{SNIPPET}</code><button type="button" data-copy={SNIPPET}>Copy</button></span></div>
          </li>
        </ol>
        <p class="small">Other ways: <a href="/docs/agents/">with your AI agent</a> · <a href="/docs/on-your-own/">without our servers</a> · <a href="/docs/hub/">your own hub</a></p>
      </section>
    </main>

    <footer class="bar">
      <span>feedbai, by <a href="https://github.com/internet4000">internet4000</a></span>
      <nav>
        <a href="/docs/privacy/">Privacy</a>
        <a href="/docs/architecture/">Where it's going</a>
      </nav>
    </footer>

    <script>
      // Listening now: /v1/ecosystem (projects that chose to be listed) and /v1/status (the hub). Built with
      // textContent only: project names come from other people's configs.
      const CHANNELS: Record<string, string> = { matrix: 'Matrix', bluesky: 'Bluesky', atproto: 'Feedback records', github: 'GitHub Discussions' }
      type Project = { id: string; repository: string; channels: string[]; filed: number; fixed: number; open: number }
      const el = (tag: string, text = '', className = '') => Object.assign(document.createElement(tag), { textContent: text, className })
      const list = document.querySelector('[data-projects]')

      const showProjects = (all: Project[]) => {
        const projects = all.filter((p) => /^https:\/\/github\.com\/[\w.-]+\/[\w.-]+$/.test(p.repository))
        if (!projects.length) return list?.replaceChildren(el('li', 'No project listed yet.', 'row muted'))
        list?.replaceChildren(
          ...projects.map((p) => {
            const li = el('li', '', 'row')
            const name = el('a', p.id, 'name') as HTMLAnchorElement
            name.href = p.repository
            const where = el('span', p.channels.map((c) => CHANNELS[c] ?? c).join(' · '), 'where')
            const counts = el('a', `${p.filed} filed · ${p.fixed} fixed`, 'counts') as HTMLAnchorElement
            counts.href = `${p.repository}/issues?q=label%3Afeedback`
            const text = el('div')
            text.append(name, where)
            li.append(text, counts)
            return li
          }),
        )
      }

      fetch('/v1/ecosystem')
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((data) => showProjects(data.projects ?? []))
        .catch(() => list?.replaceChildren(el('li', 'Unavailable right now.', 'row muted')))

      fetch('/v1/status')
        .then((r) => r.json())
        .then((data) => data.ok)
        .catch(() => null)
        .then((ok) => {
          document.querySelector('[data-hub]')?.setAttribute('data-state', ok === null ? 'unknown' : ok ? 'ok' : 'down')
          const text = document.querySelector('[data-hub-text]')
          if (text) text.textContent = ok === null ? 'Hub unreachable' : ok ? 'All channels ok' : 'A channel is down'
        })

      document.addEventListener('click', async (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]')
        if (!b) return
        try {
          await navigator.clipboard.writeText(b.dataset.copy ?? '')
          b.textContent = 'Copied'
          setTimeout(() => (b.textContent = 'Copy'), 1500)
        } catch {}
      })
    </script>

    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #fbf8f4;
        --card: #f4efe8;
        --line: #e6ded3;
        --ink: #1c1a17;
        --muted: #6b645b;
        --accent: #1a8a50;
        --ok: #2fbf71;
        --down: #e5484d;
        --radius: 0.6rem;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #151412; --card: #1e1c19; --line: #2e2b27; --ink: #ece7df; --muted: #a39b90; --accent: #4fd08a; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 17px/1.55 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
      a { color: inherit; text-underline-offset: 0.18em; }
      code { font: 0.86em ui-monospace, SFMono-Regular, Menlo, monospace; }
      main { max-width: 46rem; margin: 0 auto; padding: 0 1rem 3rem; display: grid; gap: 2.25rem; }
      .bar { max-width: 46rem; margin: 0 auto; padding: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
      .bar nav { display: flex; gap: 1.25rem; }
      .bar a { min-height: 2.75rem; display: inline-flex; align-items: center; }
      .brand { font-weight: 800; font-size: 1.15rem; letter-spacing: -0.02em; text-decoration: none; }
      footer.bar { color: var(--muted); font-size: 0.9rem; padding-bottom: 5rem; flex-wrap: wrap; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem 1.25rem 1rem; }
      h1 { font-size: 1.45rem; line-height: 1.25; margin: 0 0 0.6rem; letter-spacing: -0.01em; }
      h2 { font-size: 1.05rem; margin: 0; }
      h2 small { font-weight: 400; color: var(--muted); font-size: 0.85rem; margin-left: 0.35rem; }
      .intro ul { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.3rem; }
      .small { color: var(--muted); font-size: 0.88rem; margin: 0.75rem 0 0; }
      .actions { display: flex; flex-wrap: wrap; gap: 0 1.5rem; margin: 0.6rem 0 0; }
      .actions a { min-height: 2.75rem; display: inline-flex; align-items: center; }
      .head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.4rem; }
      .head > a { font-size: 0.9rem; color: var(--muted); min-height: 2.75rem; display: inline-flex; align-items: center; }
      .hub { gap: 0.45rem; text-decoration: none; }
      .hub .dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--muted); }
      .hub[data-state='ok'] .dot { background: var(--ok); }
      .hub[data-state='down'] .dot { background: var(--down); }
      .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
      .row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.7rem 0.9rem; min-width: 0; }
      .row.muted { color: var(--muted); }
      .row .name { font-weight: 700; text-decoration: none; margin-right: 0.6rem; }
      .row .where { color: var(--muted); font-size: 0.9rem; }
      .row .counts { flex: none; font-size: 0.9rem; font-variant-numeric: tabular-nums; color: var(--muted); }
      .steps .row { align-items: flex-start; justify-content: flex-start; }
      .steps .row > div { min-width: 0; flex: 1; }
      .n { flex: none; width: 1.6rem; height: 1.6rem; border-radius: 50%; display: inline-grid; place-items: center; background: var(--ink); color: var(--bg); font-size: 0.8rem; font-weight: 700; margin-top: 0.1rem; }
      .copy { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.45rem; background: var(--bg); border: 1px solid var(--line); border-radius: 0.45rem; padding: 0.25rem 0.25rem 0.25rem 0.65rem; min-width: 0; }
      .copy code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; }
      .copy button { flex: none; min-height: 2.25rem; padding: 0 0.7rem; border-radius: 0.35rem; border: 1px solid var(--line); background: var(--card); color: var(--ink); font: inherit; font-size: 0.85rem; cursor: pointer; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      @media (max-width: 30rem) { .row { flex-wrap: wrap; } }
    </style>
  </body>
</html>

---
/**
 * The home page. The pitch in one line ("hear your community, let your agents act on it"), the loop that
 * delivers it, four reasons, then how to start. One path, no tabs.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'

const REPO = 'https://github.com/internet4000/feedbai'
const BOT = '@feedbai:matrix.org'
const SNIPPET = '<script type="module" src="https://feedbai.internet4000.com/embed.js" data-project="https://github.com/you/repo"></script>'

// The loop, shown beside the headline
const loop = `<ol class="loop" aria-label="How it works">
  <li><span class="n">1</span><div><b>Your community speaks</b><small>In your chat, on Bluesky, with the Feedback button on your site.</small></div></li>
  <li><span class="n">2</span><div><b>feedbai gathers it</b><small>One stream, from everywhere, as GitHub issues and in your terminal.</small></div></li>
  <li><span class="n">3</span><div><b>Your agents act on it</b><small>Claude Code, Codex…: triage, fix, open the pull request.</small></div></li>
  <li><span class="n">4</span><div><b>Everyone hears back</b><small>A reply where they spoke: it's fixed.</small></div></li>
</ol>`

const reasons = [
  ['💬', 'Everywhere they talk', 'People keep using their chat, Bluesky, or your site. Nobody signs up for a feedback tool.'],
  ['🤖', 'Made for AI agents', 'Every output says what to do next. Agents read it, file it, fix it, and reply, with you in charge.'],
  ['↩️', 'Everyone hears back', 'Feedback is answered where it was given. That is what makes people give more.'],
  ['🌱', 'Nothing to host, nothing kept', 'Open source and decentralized: feedback stays with the people who wrote it. Run it without us if you like.'],
]
const faq = [
  ['Does it cost anything?', 'No. feedbai is free and open source (GPL-3.0).'],
  ['Where does the feedback go? Do you keep it?', 'We keep nothing. People write from their own accounts, in public places they chose, and feedbai files it in your repository. <a href="/docs/privacy/">Privacy notes</a>.'],
  ['Do I need an AI agent?', 'No. Feedback becomes GitHub issues you can handle yourself. Agents make the loop faster: they triage, fix and reply.'],
]
const others = [
  ['/docs/agents/', 'Agents', 'Claude Code, Codex: the triage workflow'],
  ['/docs/on-your-own/', 'Without our servers', 'your bot accounts, your CI'],
  ['/docs/hub/', 'Run your own hub', 'one bot for your team or community'],
  ['/feedback/', 'Giving feedback?', 'how it works for you'],
]
---

<StarlightPage
  frontmatter={{
    title: 'Hear your community. Let your agents act on it.',
    description: 'feedbai gathers feedback wherever people talk about your project, turns it into work for you and your AI agents, and answers back. Open, decentralized, nothing stored.',
    template: 'splash',
    hero: {
      title: 'Hear your community.<br>Let your agents act on it.',
      tagline: 'feedbai gathers feedback wherever people talk about your project (chat, Bluesky, a button on your site), turns it into work for you and your AI agents, and answers back.',
      image: { html: loop },
      actions: [
        { text: 'Get started', link: '#start', icon: 'right-arrow' },
        { text: 'Read the docs', link: '/docs/', variant: 'minimal' },
      ],
    },
  }}
>
  <div class="not-content home">
    <ul class="reasons">
      {reasons.map(([icon, title, text]) => <li><span class="icon" aria-hidden="true">{icon}</span><b>{title}</b><p>{text}</p></li>)}
    </ul>

    <h2 id="start">Get started</h2>
    <p class="sub">Three steps, about two minutes. Each one works on its own.</p>
    <ol class="steps">
      <li>
        <p><b>Let people give feedback on your site.</b> Add the Feedback button, with your repo:</p>
        <div class="copy"><code>{SNIPPET}</code><button type="button" data-copy={SNIPPET}>Copy</button></div>
        <p class="note">Try it: bottom right of this page. <a href="/docs/button/">Options</a></p>
      </li>
      <li>
        <p><b>Listen to your chat.</b> Invite the bot to your Matrix room, and install the GitHub App so messages that mention it become issues:</p>
        <div class="copy"><code>{BOT}</code><button type="button" data-copy={BOT}>Copy</button></div>
        <a class="btn" href="https://github.com/apps/feedbai">Install the GitHub App</a>
      </li>
      <li>
        <p><b>Hand it to your agent.</b> In your project, run:</p>
        <div class="copy"><code>npx github:internet4000/feedbai</code><button type="button" data-copy="npx github:internet4000/feedbai">Copy</button></div>
        <p class="note">It finds your channels, shows new feedback and says what to do next. In Claude Code: <code>!feedbai</code>.</p>
      </li>
    </ol>

    <h2>More ways</h2>
    <ul class="others">
      {others.map(([href, title, hint]) => <li><a href={href}><b>{title}</b><span>{hint}</span></a></li>)}
    </ul>

    <h2>Questions</h2>
    <div class="faqs">
      {faq.map(([q, a]) => <details class="faq"><summary>{q}</summary><div set:html={a} /></details>)}
    </div>
    <p class="more"><a href={REPO}>Source code</a> · <a href="/docs/">All docs</a> · <a href="/docs/vision/">Where it's going</a></p>
  </div>
</StarlightPage>

<script>
  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]')
    if (!b) return
    try {
      await navigator.clipboard.writeText(b.dataset.copy ?? '')
      b.textContent = 'Copied'
      setTimeout(() => (b.textContent = 'Copy'), 1500)
    } catch {}
  })
</script>

<style is:global>
  [data-has-hero] { --sl-content-width: 68rem; }
  [data-has-hero] .hero { padding-block: 1.5rem 0.5rem; }
  [data-has-hero] .hero h1 { font-size: clamp(2.1rem, 4.2vw, 3rem); line-height: 1.05; letter-spacing: -0.025em; }
  [data-has-hero] .hero .tagline { font-size: clamp(1.05rem, 2vw, 1.25rem); }
  [data-has-hero] .hero > .hero-html { order: 2; width: 100%; max-width: 30rem; }
  .loop { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; width: 100%; text-align: start; position: relative; }
  .loop li { position: relative; display: flex; gap: 0.85rem; align-items: flex-start; padding: 0 0 1.1rem; color: var(--sl-color-white); font-size: var(--sl-text-base); }
  .loop li:not(:last-child)::after { content: ''; position: absolute; left: 0.95rem; top: 2.1rem; bottom: 0.25rem; width: 2px; background: var(--sl-color-hairline); }
  .loop li:last-child { padding-bottom: 0; }
  .loop .n { flex: none; display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--sl-color-accent); color: var(--sl-color-black); font-weight: 700; font-size: var(--sl-text-sm); }
  .loop li:last-child .n { background: var(--sl-color-accent-high); color: var(--sl-color-black); }
  .loop b { display: block; line-height: 1.35; }
  .loop small { display: block; color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); margin-top: 0.15rem; }
  @media (min-width: 50rem) { [data-has-hero] .hero { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 3rem; } }
</style>

<style>
  .home { color: var(--sl-color-white); }
  h2 { font-size: var(--sl-text-2xl); margin: 3.5rem 0 0.25rem; scroll-margin-top: 5rem; }
  .sub { color: var(--sl-color-gray-3); margin: 0 0 1rem; }
  .reasons { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.75rem; }
  .reasons li { background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-hairline); border-radius: 0.9rem; padding: 1rem; }
  .reasons .icon { font-size: 1.4rem; display: block; margin-bottom: 0.35rem; }
  .reasons b { display: block; margin-bottom: 0.2rem; }
  .reasons p { margin: 0; color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
  .steps { list-style: none; margin: 0; padding: 0; counter-reset: s; display: grid; gap: 0.75rem; }
  .steps li { min-width: 0; counter-increment: s; background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-hairline); border-radius: 0.9rem; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .steps li::before { content: counter(s); display: inline-grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--sl-color-accent); color: var(--sl-color-black); font-weight: 700; font-size: var(--sl-text-sm); }
  .steps p { margin: 0; }
  .home :global(code) { background: var(--sl-color-gray-6); padding: 0.05rem 0.3rem; border-radius: 0.3rem; font-size: 0.9em; }
  .home a:not(.btn) { color: var(--sl-color-text-accent); }
  .note { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
  .btn { margin-top: auto; display: flex; align-items: center; justify-content: center; min-height: 3rem; border-radius: 0.75rem; background: var(--sl-color-accent); color: var(--sl-color-black); font-weight: 600; text-decoration: none; }
  .copy { min-width: 0; display: flex; align-items: center; gap: 0.5rem; background: var(--sl-color-gray-6); border-radius: 0.75rem; padding: 0.35rem 0.35rem 0.35rem 0.85rem; min-height: 3rem; }
  .copy code { flex: 1; overflow-x: auto; white-space: nowrap; font-family: var(--__sl-font-mono); font-size: var(--sl-text-sm); background: none; padding: 0; }
  .copy button { flex: none; min-height: 2.25rem; padding: 0 0.75rem; border-radius: 0.5rem; border: 1px solid var(--sl-color-hairline); background: var(--sl-color-bg-nav); color: var(--sl-color-white); font: inherit; font-size: var(--sl-text-sm); font-weight: 600; cursor: pointer; }
  .others { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.5rem; }
  .others a { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.8rem 1rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.9rem; background: var(--sl-color-bg-nav); text-decoration: none; min-height: 3rem; }
  .others b { color: var(--sl-color-white); }
  .others span { color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
  .faqs { margin-top: 1rem; display: grid; gap: 0.5rem; align-items: start; }
  .faq { background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-hairline); border-radius: 0.9rem; }
  .faq summary { cursor: pointer; padding: 0.85rem 1rem; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 0.75rem; min-height: 3rem; align-items: center; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--sl-color-gray-3); font-weight: 400; font-size: 1.4rem; line-height: 1; }
  .faq[open] summary::after { content: '−'; }
  .faq > div { padding: 0 1rem 0.9rem; color: var(--sl-color-gray-2); }
  .more { margin-top: 2rem; padding-bottom: 4rem; color: var(--sl-color-gray-3); }
  @media (min-width: 40rem) { .reasons, .others { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 50rem) {
    .reasons { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .others { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .faqs { grid-template-columns: repeat(3, 1fr); }
  }
</style>

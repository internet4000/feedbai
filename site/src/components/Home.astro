---
/**
 * The home page: what feedbai does, how to start in three steps, and where the other ways are documented.
 * One path, no tabs: someone new should get it in ten seconds and be set up in two minutes.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'

const REPO = 'https://github.com/internet4000/feedbai'
const BOT = '@feedbai:matrix.org'
const SNIPPET = '<script type="module" src="https://feedbai.internet4000.com/embed.js" data-project="https://github.com/you/repo"></script>'
const flow = `<ol class="flow">
  <li><span class="icon">💬</span><div>Someone sends feedback<small>With the Feedback button on your site, in your chat, or on Bluesky.</small></div></li>
  <li><span class="icon">📋</span><div>It becomes a GitHub issue<small>Labelled <b>feedback</b>, with a link back to them.</small></div></li>
  <li><span class="icon">🛠️</span><div>You or your AI agent fix it<small>And they hear back where they wrote.</small></div></li>
</ol>`
const faq = [
  ['Does it cost anything?', 'No. feedbai is free and open source (GPL-3.0).'],
  ['Where does the feedback go? Do you keep it?', 'We keep nothing. People send feedback from their own accounts to public places (a GitHub issue, Bluesky, your chat room), and feedbai files it in your repository. <a href="/docs/privacy/">Privacy notes</a>.'],
  ['Can I use it without your servers?', 'Yes: your own bot accounts and your own CI, nothing through us. <a href="/docs/on-your-own/">How</a>.'],
]
const others = [
  ['/docs/agents/', 'With your AI agent', 'Claude Code, Codex: triage, fix, reply'],
  ['/docs/on-your-own/', 'Without our servers', 'your bots, your CI'],
  ['/docs/hub/', 'Run your own hub', 'one bot for your team or community'],
  ['/feedback/', 'Giving feedback on a project?', 'how it works for you'],
]
---

<StarlightPage
  frontmatter={{
    title: 'User feedback, straight into your issues',
    description: 'A feedback button for your site, and your chat: feedback becomes GitHub issues you and your AI agent fix. Free, open source, nothing stored.',
    template: 'splash',
    hero: {
      title: "Your users' feedback, straight into your GitHub issues.",
      tagline: 'Add a Feedback button to your site, or let people mention the bot in your chat. feedbai turns what they say into issues you and your AI agent can fix.',
      image: { html: flow },
      actions: [
        { text: 'Start in 2 minutes', link: '#start', icon: 'right-arrow' },
        { text: 'Docs', link: '/docs/', variant: 'minimal' },
      ],
    },
  }}
>
  <div class="not-content home">
    <h2 id="start">Start in 2 minutes</h2>
    <ol class="steps">
      <li>
        <p><b>Add the Feedback button</b> to your site, with your repo:</p>
        <div class="copy"><code>{SNIPPET}</code><button type="button" data-copy={SNIPPET}>Copy</button></div>
        <p class="note">Try it: bottom right of this page. <a href="/docs/button/">Options</a></p>
      </li>
      <li>
        <p><b>Connect your chat</b> (optional). Invite the bot to your Matrix room, and install the App so its messages become issues:</p>
        <div class="copy"><code>{BOT}</code><button type="button" data-copy={BOT}>Copy</button></div>
        <a class="btn" href="https://github.com/apps/feedbai">Install the GitHub App</a>
      </li>
      <li>
        <p><b>Read it with your AI agent.</b> In your project, run:</p>
        <div class="copy"><code>npx github:internet4000/feedbai</code><button type="button" data-copy="npx github:internet4000/feedbai">Copy</button></div>
        <p class="note">New feedback, your open issues, and what to do next. In Claude Code: <code>!feedbai</code>.</p>
      </li>
    </ol>

    <h2>Other ways</h2>
    <ul class="others">
      {others.map(([href, title, hint]) => <li><a href={href}><b>{title}</b><span>{hint}</span></a></li>)}
    </ul>

    <h2>Questions</h2>
    <div class="faqs">
      {faq.map(([q, a]) => <details class="faq"><summary>{q}</summary><div set:html={a} /></details>)}
    </div>
    <p class="more"><a href={REPO}>Source code</a> · <a href="/docs/">All docs</a></p>
  </div>
</StarlightPage>

<script>
  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]')
    if (!b) return
    try {
      await navigator.clipboard.writeText(b.dataset.copy ?? '')
      b.textContent = 'Copied'
      setTimeout(() => (b.textContent = 'Copy'), 1500)
    } catch {}
  })
</script>

<style is:global>
  [data-has-hero] { --sl-content-width: 68rem; }
  [data-has-hero] .hero { padding-block: 1rem 0; }
  [data-has-hero] .hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.08; letter-spacing: -0.02em; }
  [data-has-hero] .hero > .hero-html { order: 2; width: 100%; max-width: 30rem; }
  .flow { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; width: 100%; text-align: start; }
  .flow li { min-width: 0; background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-hairline); border-radius: 0.9rem; padding: 0.85rem 1rem; display: flex; gap: 0.75rem; align-items: flex-start; font-size: var(--sl-text-base); color: var(--sl-color-white); }
  .flow .icon { font-size: 1.35rem; line-height: 1.3; }
  .flow small { display: block; color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); margin-top: 0.15rem; }
  @media (min-width: 50rem) { [data-has-hero] .hero { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 3.5rem; } }
</style>

<style>
  .home { color: var(--sl-color-white); }
  h2 { font-size: var(--sl-text-2xl); margin: 3rem 0 1rem; scroll-margin-top: 5rem; }
  .steps { list-style: none; margin: 0; padding: 0; counter-reset: s; display: grid; gap: 0.75rem; }
  .steps li { min-width: 0; counter-increment: s; background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-hairline); border-radius: 0.9rem; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .steps li::before { content: counter(s); display: inline-grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--sl-color-accent); color: var(--sl-color-black); font-weight: 700; font-size: var(--sl-text-sm); }
  .steps p { margin: 0; }
  .home :global(code) { background: var(--sl-color-gray-6); padding: 0.05rem 0.3rem; border-radius: 0.3rem; font-size: 0.9em; }
  .home a:not(.btn) { color: var(--sl-color-text-accent); }
  .note { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
  .btn { margin-top: auto; display: flex; align-items: center; justify-content: center; min-height: 3rem; border-radius: 0.75rem; background: var(--sl-color-accent); color: var(--sl-color-black); font-weight: 600; text-decoration: none; }
  .copy { min-width: 0; display: flex; align-items: center; gap: 0.5rem; background: var(--sl-color-gray-6); border-radius: 0.75rem; padding: 0.35rem 0.35rem 0.35rem 0.85rem; min-height: 3rem; }
  .copy code { flex: 1; overflow-x: auto; white-space: nowrap; font-family: var(--__sl-font-mono); font-size: var(--sl-text-sm); background: none; padding: 0; }
  .copy button { flex: none; min-height: 2.25rem; padding: 0 0.75rem; border-radius: 0.5rem; border: 1px solid var(--sl-color-hairline); background: var(--sl-color-bg-nav); color: var(--sl-color-white); font: inherit; font-size: var(--sl-text-sm); font-weight: 600; cursor: pointer; }
  .others { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .others a { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.8rem 1rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.9rem; background: var(--sl-color-bg-nav); text-decoration: none; min-height: 3rem; }
  .others b { color: var(--sl-color-white); }
  .others span { color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
  .faqs { display: grid; gap: 0.5rem; align-items: start; }
  .faq { background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-hairline); border-radius: 0.9rem; }
  .faq summary { cursor: pointer; padding: 0.85rem 1rem; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 0.75rem; min-height: 3rem; align-items: center; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--sl-color-gray-3); font-weight: 400; font-size: 1.4rem; line-height: 1; }
  .faq[open] summary::after { content: '−'; }
  .faq > div { padding: 0 1rem 0.9rem; color: var(--sl-color-gray-2); }
  .more { margin-top: 2rem; color: var(--sl-color-gray-3); }
  @media (min-width: 40rem) { .others { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 50rem) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } .faqs { grid-template-columns: repeat(3, 1fr); } }
</style>
